<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.gathin.tvhome.dashboard</item>   <!-- built-in web dashboard; hidden while dashboard_url is empty -->
        <item>com.stremio.one</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.apple.atve.androidtv.appletv</item>
        <item>com.gathin.tvhome.inputs</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">5</integer>

    <!--
      Web dashboard (e.g. an STR / short-term-rental KPI page) shown full screen from its dock tile.
      Every value below can also be changed on the TV over ADB without rebuilding: see
      "Web dashboard" in launcher/DASHBOARD.md.
    -->
    <!-- http(s) address of the dashboard, or a page bundled in app/src/main/assets as
         file:///android_asset/<path>. Leave empty to hide the Dashboard tile. -->
    <string name="dashboard_url" translatable="false"></string>
    <!-- Make the dashboard the home screen: Home opens it, and its TV button opens the app grid. -->
    <bool name="dashboard_home">false</bool>
    <!-- Shown while the page loads. -->
    <string name="dashboard_title" translatable="false">STR Dashboard</string>
    <!-- Open the dashboard by itself once after every boot (bar / lobby TVs). -->
    <bool name="dashboard_autostart">false</bool>
    <!-- Go back to the dashboard after this many minutes untouched on the home screen. 0 = never. -->
    <integer name="dashboard_idle_minutes">0</integer>
    <!-- Reload the page this often, for dashboards that don't refresh themselves. 0 = never. -->
    <integer name="dashboard_reload_minutes">15</integer>
    <!-- Initial page scale in percent; 0 fits the page to the screen width. Try 75 if it looks cramped. -->
    <integer name="dashboard_zoom_percent">0</integer>
    <!-- Ask sites for their desktop layout instead of the phone one. -->
    <bool name="dashboard_desktop_mode">true</bool>
</resources>
