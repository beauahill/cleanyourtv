<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen dashboard. The WebView is added in code at index 0, under the status card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Loading / offline / not-configured message. Opaque so the WebView's own error page never shows. -->
    <LinearLayout
        android:id="@+id/dashStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:id="@+id/dashStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 300"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/dashStatusDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/outfit"
            android:gravity="center"
            android:textColor="#99FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>
