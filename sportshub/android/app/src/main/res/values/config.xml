<?xml version="1.0" encoding="utf-8"?>
<!--
  Kiosk configuration. The URL can also be changed without rebuilding:
    tools/tv.py 'am start -n com.sportshub.tv/.MainActivity --es url http://192.168.1.50:8777/'
  The app remembers the last URL it was given.
-->
<resources>
    <!-- Where server.py is running. Use the mini PC's LAN IP, not localhost. -->
    <string name="hub_url" translatable="false">http://192.168.1.50:8777/</string>
    <!-- Keep the screen awake while the hub is showing (the stick's screensaver still applies if
         you prefer: set this to false). -->
    <bool name="keep_screen_on">true</bool>
</resources>
