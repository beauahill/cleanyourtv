<?xml version="1.0" encoding="utf-8"?>
<!--
  Kiosk configuration. The URL can also be changed without rebuilding:
    tools/tv.py 'am start -n com.sportshub.tv/.MainActivity' with an extra string "url" (see STICK-SETUP.md)
  The app remembers the last URL it was given.
-->
<resources>
    <!-- Stick-only by default: the page is bundled and talks to ESPN itself. To use a PC-hosted
         Sports Hub instead, set this to its URL (e.g. http://192.168.1.50:8777/) or start the app
         once with  am start -n com.sportshub.tv/.MainActivity --es url http://...  -->
    <string name="hub_url" translatable="false"></string>
    <!-- Keep the screen awake while the hub is showing (the stick's screensaver still applies if
         you prefer: set this to false). -->
    <bool name="keep_screen_on">true</bool>
</resources>
